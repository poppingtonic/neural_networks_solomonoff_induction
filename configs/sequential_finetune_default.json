{
  "experiment_name": "sequential_utm_ctw",
  "model": {
    "name_or_path": "lstm",
    "architecture": "lstm",
    "use_hf": false,
    "device": "cuda",
    "hidden_dim": 256,
    "num_layers": 2,
    "embedding_dim": 128
  },
  "stages": {
    "utm": {
      "enabled": true,
      "steps": 10000,
      "lr": 1e-5,
      "batch_size": 32,
      "seq_length": 256,
      "data_config": {
        "memory_size": 10,
        "maximum_steps": 100,
        "tokenizer": "ascii",
        "maximum_program_length": 100
      }
    },
    "ctw": {
      "enabled": true,
      "steps": 5000,
      "lr": 5e-6,
      "batch_size": 32,
      "seq_length": 256,
      "data_config": {
        "max_depth": 5
      }
    }
  },
  "training": {
    "seed": 42,
    "save_every": 1000,
    "log_every": 100,
    "output_dir": "./checkpoints/sequential"
  },
  "advanced": {
    "use_dni": false,
    "use_bitnet": false,
    "enable_mswag": false,
    "use_sgm": false
  }
}
