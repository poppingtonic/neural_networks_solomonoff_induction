{
  "base_model": "Qwen/Qwen3-30B-A3B-Instruct",
  "lora_rank": 32,
  "adam": {
    "learning_rate": 0.0003,
    "beta1": 0.9,
    "beta2": 0.95,
    "eps": 1e-12
  },
  "batch_size": 8,
  "seq_length": 256,
  "save_every": 50,
  "log_every": 10,
  "output_dir": "./runs/tinker_utm_voms_sft",
